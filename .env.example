# FoodTrail — Supabase Public Client Environment Variables
# Copy this file to .env and ensure it is NEVER committed to version control.
# Only use public anon / publishable keys here; NEVER place a service-role key in the mobile application.

EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-api-key>

# Optional alternative: Supabase publishable key format
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
